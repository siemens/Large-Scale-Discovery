.DS_Store

# Goland (developer-specific stuff)
/.idea/workspace.xml
/.idea/dataSources.xml
/.idea/GitlabLint.xml

# Compiled executables
/_bin/*.exe
/_bin/*.bin

# Log files, no matter where
*.log
*.log.*

# Application generated files
/_bin/*.conf
/_bin/*.sqlite
/_bin/*.sqlite-shm
/_bin/*.sqlite-wal
/_bin/download_urls.csv
/_bin/data/os_truststore.pem

# Production keys
/_bin/keys/manager.key
/_bin/keys/manager.crt
/_bin/keys/broker.key
/_bin/keys/broker.crt
/_bin/keys/backend.key
/_bin/keys/backend.crt

# Cached stats files
.instance

# Web frontend developer and generated files
/web_frontend/.idea/workspace.xml
/web_frontend/.npm/
/web_frontend/dist/
/web_frontend/node_modules/
/web_frontend/tests/artifacts/
*.tsbuildinfo

# CI generated files
/.go/

# Application production folders
/_bin/data/nuclei_templates/
/_bin/tools/

# Unit test output
/_test/
